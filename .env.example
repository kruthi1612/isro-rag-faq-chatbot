# LLM Provider API Keys (Multi-Provider Fallback: Groq -> Gemini -> OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration (huggingface: zero token usage, fast CPU / openai: text-embedding-3-small)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Primary & Fallback LLM Models
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# FAQ Caching (1 = enable, 0 = disable)
ENABLE_FAQ_CACHE=1
FAQ_CACHE_DB=./isro_faq_cache.sqlite
